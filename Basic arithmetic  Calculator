#include <stdio.h>
#include <stdlib.h>
int main()
{
int a,b,c,ch;
printf("Enter your 1st no.");
scanf("%d",&a);
printf ("Enter your 2nd no.");
scanf("%d",&b);
while(1)
{
    printf("1 for addition\n");
    printf("2 for subtraction\n");
    printf("3 for multiplication\n");
    printf("4 for division\n");
    printf("5 to exit\n");

    scanf("%d",&ch);
    switch(ch)
    {
    case 1:
    c=a+b;
    printf("%d\n",c);
    break;
    case 2:
    c=a-b;
    printf("%d\n",c);
    break;
    case 3:
    c=a*b;
    printf("%d\n",c);
    break;
    case 4:
    c=a/b;
    printf("%d\n",c);
    break;
    case 5:
    printf("\n\n\t\t\t not valid! \n\n");
    exit(0);
    }
}
return 0;
}
